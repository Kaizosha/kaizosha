{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaizosha",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
